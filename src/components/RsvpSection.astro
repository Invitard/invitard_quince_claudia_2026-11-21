---
// RsvpSection.astro
const whatsappMessage = encodeURIComponent("¡Hola Amparo! Deseo confirmar con mucho gusto mi asistencia a la fiesta de XV Años de Claudia para el sábado 21 de noviembre de 2026. ✨");
const whatsappUrl = `https://api.whatsapp.com/send?phone=51991399575&text=${whatsappMessage}`;
---

<div class="rsvp-wrapper">
	<div class="rsvp-icon-box">
		<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
			<line x1="16" y1="2" x2="16" y2="6"></line>
			<line x1="8" y1="2" x2="8" y2="6"></line>
			<line x1="3" y1="10" x2="21" y2="10"></line>
			<path d="M12 14c-1.5-1.5-3-1-3 0.5 0 1.2 3 3 3 3s3-1.8 3-3c0-1.5-1.5-2-3-0.5z"></path>
		</svg>
	</div>

	<h3 class="rsvp-title">Confirmar asistencia</h3>
	<p class="rsvp-instruction">POR FAVOR CONFIRMA TU ASISTENCIA A LA BREVEDAD</p>
	<p class="rsvp-contact">Coordinación con: <strong>Amparo Ortiz</strong></p>

	<!-- Action Button -->
	<a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-confirm-rsvp">
		<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
			<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.01-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.61c.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z"/>
		</svg>
		<span>CONFIRMAR POR WHATSAPP</span>
	</a>

	<div class="rsvp-farewell-box">
		<p class="rsvp-note">
			Con mucho cariño, esta celebración es para que compartamos y disfrutemos juntos una noche mágica.
		</p>
		<p class="rsvp-highlight">
			TU PRESENCIA Y ALEGRÍA HARÁ QUE ESTA NOCHE SEA INOLVIDABLE.
		</p>
	</div>
</div>

<style>
	.rsvp-wrapper {
		margin: 24px auto;
		max-width: 340px;
		text-align: center;
		padding: 24px 20px 20px;
		background: rgba(255, 255, 255, 0.7);
		border-radius: 20px;
		border: 1px solid rgba(246, 185, 19, 0.35);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
	}

	.rsvp-icon-box {
		width: 48px;
		height: 48px;
		margin: 0 auto 12px;
		background: linear-gradient(135deg, rgba(200, 164, 200, 0.25), rgba(186, 217, 245, 0.3));
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--c-gold-dark);
		border: 1px solid rgba(246, 185, 19, 0.4);
	}

	.rsvp-title {
		font-family: var(--font-script);
		font-size: 38px;
		color: var(--c-gold-dark);
		margin: 0;
		font-weight: normal;
		line-height: 1;
	}

	.rsvp-instruction {
		font-family: var(--font-serif);
		font-size: 10px;
		letter-spacing: 2px;
		color: var(--c-text-light);
		margin: 6px 0 4px;
		font-weight: 600;
	}

	.rsvp-contact {
		font-size: 12px;
		color: var(--c-text-body);
		margin-bottom: 16px;
	}

	.btn-confirm-rsvp {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		background: var(--gold-gradient);
		color: #ffffff;
		padding: 13px 20px;
		border-radius: 25px;
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1.5px;
		box-shadow: 0 5px 18px rgba(246, 185, 19, 0.45);
		transition: all 0.3s ease;
		margin: 0 auto 20px;
		max-width: 280px;
	}

	.btn-confirm-rsvp:hover {
		transform: translateY(-2px) scale(1.02);
		box-shadow: 0 7px 22px rgba(246, 185, 19, 0.6);
	}

	.rsvp-farewell-box {
		padding-top: 14px;
		border-top: 1px dashed rgba(246, 185, 19, 0.4);
	}

	.rsvp-note {
		font-size: 11.5px;
		color: var(--c-text-body);
		line-height: 1.5;
		margin-bottom: 10px;
	}

	.rsvp-highlight {
		font-family: var(--font-serif);
		font-size: 10.5px;
		letter-spacing: 1.8px;
		color: var(--c-gold-dark);
		font-weight: 700;
		line-height: 1.4;
	}
</style>

